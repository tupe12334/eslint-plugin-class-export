# Environment variables for release process
# Copy this file to .env and fill in your tokens

# NPM Token for publishing packages
# Get from: https://www.npmjs.com/settings/[username]/tokens
NPM_TOKEN=npm_your_token_here

# GitHub Token for creating releases
# Get from: https://github.com/settings/tokens
# Required scopes: repo, write:packages
GITHUB_TOKEN=ghp_your_token_here