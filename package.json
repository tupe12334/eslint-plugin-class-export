{
  "name": "eslint-plugin-class-export",
  "version": "1.0.0",
  "description": "ESLint plugin to enforce class export rules",
  "main": "index.js",
  "scripts": {
    "test": "pnpm exec jest",
    "test:watch": "pnpm exec jest --watch",
    "lint": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "prerelease": "pnpm test && pnpm lint",
    "release": "pnpm dlx dotenv-cli pnpm exec release-it",
    "release:dry": "pnpm exec release-it --dry-run --no-npm --no-github",
    "clean": "rm -rf node_modules pnpm-lock.yaml",
    "fresh": "pnpm clean && pnpm install"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "class",
    "export",
    "module"
  ],
  "author": "Ofek Gabay",
  "license": "MIT",
  "engines": {
    "node": ">=12.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@release-it/conventional-changelog": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.3.0",
    "jest": "^29.0.0",
    "release-it": "^17.0.0"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tupe12334/eslint-plugin-class-export.git"
  },
  "bugs": {
    "url": "https://github.com/tupe12334/eslint-plugin-class-export/issues"
  },
  "homepage": "https://github.com/tupe12334/eslint-plugin-class-export#readme"
}
